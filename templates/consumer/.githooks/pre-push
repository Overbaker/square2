#!/bin/sh
# square² local gate: the same check CI runs, on exactly the commits being pushed, before
# anything leaves this machine. Writes nothing into the repository.
# Activate once with: git config core.hooksPath .githooks
# Skip in an emergency with: git push --no-verify (the server-side gate still records it).
#
# git passes the remote name and url as arguments and one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
cd "$(git rev-parse --show-toplevel)" || exit 1
remote="${1:-origin}"
# the remote's default branch (origin/HEAD), for refs the remote does not have yet
default="$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # deleting a remote ref: nothing to check
  base=""
  case "$remote_sha" in
    *[!0]*) if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then base="$remote_sha"; fi ;;
  esac
  if [ -z "$base" ] && [ -n "$default" ]; then
    base="$(git merge-base "$local_sha" "$default" 2>/dev/null || true)"
  fi
  echo "square2: checking $local_ref (${local_sha%"${local_sha#????????????}"}) for $remote_ref" >&2
  if [ -n "$base" ]; then
    node tools/square2/bin/square2.mjs check --rev "$local_sha" --base "$base" || status=1
  else
    node tools/square2/bin/square2.mjs check --rev "$local_sha" || status=1
  fi
done
if [ "$status" -ne 0 ]; then
  echo "square2: push aborted; fix the violations above (each line says Instead: what to do)" >&2
  exit 1
fi
exit 0
