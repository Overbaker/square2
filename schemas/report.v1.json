{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:square2:schema:report:v1",
  "title": "square2-report.json",
  "description": "Canonical JSON: sorted keys and sorted arrays. Per rule, hits = new + baselined + excepted. A new_violations item with line null and count N reports a fingerprint N over its baseline count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo",
    "head_sha",
    "runner_version",
    "catalogue_digest",
    "engine_versions",
    "today",
    "exit_code",
    "rules",
    "new_violations",
    "observed",
    "excepted",
    "expired_exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repo": {
      "type": "string"
    },
    "head_sha": {
      "type": "string"
    },
    "runner_version": {
      "type": "string"
    },
    "catalogue_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engine_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hits",
          "new",
          "baselined",
          "excepted",
          "expired"
        ],
        "properties": {
          "unknown": {
            "type": "boolean",
            "description": "true when the rule's result is unknown for this run (pattern timeout): no violations reported, its issues are not auto-closed"
          },
          "hits": {
            "type": "integer",
            "minimum": 0
          },
          "new": {
            "type": "integer",
            "minimum": 0
          },
          "baselined": {
            "type": "integer",
            "minimum": 0
          },
          "excepted": {
            "type": "integer",
            "minimum": 0
          },
          "expired": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "new_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "path",
          "line",
          "message",
          "fingerprint",
          "count"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "observed": {
      "description": "Every fingerprint observed in this run (new, baselined or excepted), unique by fingerprint.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "rule_id",
          "path",
          "count"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "excepted": {
      "description": "Fingerprints covered by a live exception, unique by fingerprint and exception id.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "rule_id",
          "path",
          "exception_id",
          "count"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "exception_id": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "expired_exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
