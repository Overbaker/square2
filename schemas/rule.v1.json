{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:square2:schema:rule:v1",
  "title": "square2 rule file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Repo-relative glob ('\\\\' counts as '/'; leading './' is stripped). Rejected when absolute, a drive path, containing a '..' segment or a C0 control character, or only '.' segments.",
      "allOf": [
        {
          "not": {
            "pattern": "^\\s*(?:\\.[/\\\\]+(?![/\\\\]))*(?:[/\\\\]|[A-Za-z]:)"
          }
        },
        {
          "not": {
            "pattern": "(?:^\\s*|[/\\\\])\\.\\.(?:[/\\\\]|\\s*$)"
          }
        },
        {
          "not": {
            "pattern": "^\\s*[/\\\\]*(?:\\.(?:[/\\\\]+\\.)*)?[/\\\\]*\\s*$"
          }
        },
        {
          "not": {
            "pattern": "[\u0000-\u001f]"
          }
        }
      ]
    },
    "globs": {
      "oneOf": [
        {
          "$ref": "#/$defs/glob"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/glob"
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dune_rule",
        "engine",
        "scope",
        "instead",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$",
          "description": "Stable id; .square2/fixtures/<id>/bad/ must exist"
        },
        "dune_rule": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "engine": {
          "enum": [
            "command",
            "depcruise",
            "eslint",
            "pattern",
            "ruff",
            "suppressions"
          ]
        },
        "scope": {
          "$ref": "#/$defs/globs"
        },
        "exclude": {
          "oneOf": [
            {
              "$ref": "#/$defs/glob"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/glob"
              }
            }
          ]
        },
        "instead": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "description": {
          "type": "string"
        },
        "options": {
          "type": "object"
        },
        "born_from": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "Commit that introduced the real defect this rule was born from."
        },
        "replay": {
          "allOf": [
            {
              "$ref": "#/$defs/glob"
            },
            {
              "not": {
                "pattern": "[*?]"
              }
            }
          ],
          "description": "Replay report path (default .square2/replay/<id>.json). Required with born_from when config require_provenance is true."
        },
        "require_reason": {
          "type": "boolean",
          "description": "suppressions engine only: report only suppressions without reason text."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "require_reason"
            ]
          },
          "then": {
            "properties": {
              "engine": {
                "const": "suppressions"
              }
            }
          }
        }
      ]
    }
  }
}
